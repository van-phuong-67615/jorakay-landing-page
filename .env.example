# Copy to .env.local. Do not commit .env.local or share secrets in chat.
# Exact browser origin (no path); use your real HTTPS domain in production.
APP_URL=http://127.0.0.1:3000

# Apps Script deployment URL, ending in /exec (not /dev).
GOOGLE_APPS_SCRIPT_URL=
# Generate >=32 random characters; set the SAME value in Apps Script's
# Script Properties under GOOGLE_APPS_SCRIPT_SECRET.
GOOGLE_APPS_SCRIPT_SECRET=

# Cloudflare Turnstile widget: public site key + private secret key.
# Allow your production hostname and localhost/127.0.0.1 in the widget settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Change when the consent wording/policy changes.
PRIVACY_POLICY_VERSION=2026-10-20

# Optional public social URLs. Empty values render footer links with href="#".
# Restart dev or rebuild/redeploy after changing these values.
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=
NEXT_PUBLIC_SOCIAL_ZALO_URL=
NEXT_PUBLIC_SOCIAL_TIKTOK_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=

# Google Sheet ID and tab name are configured in Apps Script Script Properties,
# NOT here. See docs/GOOGLE_SHEETS_INTEGRATION.md.
